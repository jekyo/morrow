MORROW_API_KEY=change-me
MORROW_PORT=3000
MORROW_DATA_DIR=./data
MORROW_MAX_PROFILES=5
MORROW_LAUNCH_TIMEOUT=60
# Dev only: extra hosts allowed to load /_next/* when you open `npm run dev`
# from something other than localhost (a LAN IP, hostname, or tunnel).
# Comma-separated, no protocol/port. Leave unset if you use localhost.
# MORROW_DEV_ORIGINS=morrow.local,192.168.1.50
