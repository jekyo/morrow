{
  "name": "morrow",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "MORROW_IT=1 vitest run tests/integration --testTimeout=300000",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "playwright-core": "1.60.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "camoufox-js": "^0.12.0",
    "geist": "^1.7.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swagger-ui-react": "^5.32.13",
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "daisyui": "^5.7.16",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
